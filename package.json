{
	"name": "agents.yaml-workspace",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"change": "changeset",
		"check": "pnpm run \"/^check:.*/\"",
		"check:fmt": "dprint check",
		"check:oxlint": "vp check --no-fmt",
		"fmt": "dprint fmt",
		"fmt:check": "pnpm run check:fmt",
		"lint": "pnpm run check:oxlint",
		"release": "pnpm run release:publish",
		"release:publish": "pnpm build && changeset publish",
		"release:version": "changeset version",
		"staged": "vp staged",
		"test": "vp run -r test",
		"test:watch": "vp run -r --parallel --no-cache test:watch",
		"verify": "pnpm run check && pnpm run test && pnpm run build",
		"workflows": "pnpm run workflows:update",
		"workflows:update": "./scripts/upgrade-workflows.node.ts"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@changesets/config": "4.0.1",
		"@dprint/json": "0.24.0",
		"@dprint/markdown": "0.24.0",
		"@dprint/oxc": "0.41.0",
		"@dprint/toml": "0.8.0",
		"@types/node": "26.6.3",
		"agents.yaml": "workspace:*",
		"dprint": "0.57.4",
		"dprint-plugin-markup": "0.27.5",
		"dprint-plugin-yaml": "0.6.0",
		"typescript": "7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"node": "26.10.0",
		"pnpm": "12.6.0"
	}
}

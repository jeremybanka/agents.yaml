{
  "name": "agents.yaml-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "change": "changeset",
    "check": "vp check && vp test && pnpm --filter agents.yaml check",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "release": "pnpm build && changeset publish",
    "staged": "vp staged",
    "test": "vp run -r test",
    "typecheck": "pnpm --filter agents.yaml typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@changesets/config": "3.1.4",
    "@types/node": "25.9.2",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
    "vite-plus": "0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
  },
  "engines": {
    "node": "26.3.0",
    "pnpm": "11.5.2"
  },
  "packageManager": "pnpm@11.5.2"
}

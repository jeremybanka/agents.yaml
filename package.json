{
	"name": "agents.yaml-workspace",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"change": "changeset",
		"check": "pnpm run \"/^check:.*/\"",
		"check:fmt": "dprint check",
		"check:vp": "vp check --no-fmt",
		"fmt": "dprint fmt",
		"release:publish": "pnpm build && changeset publish",
		"release:version": "changeset version",
		"staged": "vp staged",
		"test": "vp run -r test",
		"test:watch": "vp run -r --parallel --no-cache test:watch",
		"workflows:update": "./scripts/upgrade-workflows.node.ts"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@changesets/config": "4.0.1",
		"@dprint/json": "0.26.0",
		"@dprint/markdown": "0.29.0",
		"@dprint/oxc": "0.49.1",
		"@dprint/toml": "0.10.0",
		"@types/node": "26.6.6",
		"agents.yaml": "workspace:*",
		"dprint": "0.64.3",
		"dprint-plugin-markup": "0.27.6",
		"dprint-plugin-yaml": "0.6.0",
		"typescript": "7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": "26.13.1",
		"pnpm": "12.18.0"
	}
}

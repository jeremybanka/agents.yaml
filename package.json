{
	"name": "agents.yaml-workspace",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"change": "changeset",
		"check": "vp check --no-fmt",
		"fmt": "dprint fmt",
		"fmt:check": "dprint check",
		"lint": "vp lint",
		"release": "pnpm build && changeset publish",

{
	"name": "agents.yaml-workspace",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"change": "changeset",
		"check": "vp check --no-fmt",
		"fmt": "dprint fmt",
		"fmt:check": "dprint check",
		"lint": "vp lint",
		"release": "pnpm build && changeset publish",
		"staged": "vp staged",
		"test": "vp run -r test",
		"workflows": "./scripts/upgrade-workflows.node.ts"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@changesets/config": "4.0.1",
		"@dprint/json": "0.24.0",
		"@dprint/markdown": "0.24.0",
		"@dprint/oxc": "0.40.0",
		"@dprint/toml": "0.8.0",
		"@types/node": "26.6.1",
		"agents.yaml": "workspace:*",
		"dprint": "0.57.4",
		"dprint-plugin-markup": "0.27.3",
		"dprint-plugin-yaml": "0.6.0",
		"typescript": "7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
		"vite-plus": "0.3.3",
		"vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
	},
	"packageManager": "pnpm@12.4.2",
	"engines": {
		"node": "26.9.0",
		"pnpm": "12.4.2"
	}
}

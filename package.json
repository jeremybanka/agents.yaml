		"test": "vp run -r test",
		"workflows": "./scripts/upgrade-workflows.node.ts"
	},
	"devDependencies": {
		"@changesets/cli": "2.31.1",
		"@changesets/config": "3.1.4",
		"@dprint/json": "0.23.0",
		"@dprint/markdown": "0.22.1",
		"@dprint/oxc": "0.34.0",
		"@dprint/toml": "0.7.0",
		"@types/node": "25.9.5",
		"agents.yaml": "workspace:*",
		"dprint": "0.55.2",
		"dprint-plugin-markup": "0.27.3",
		"dprint-plugin-yaml": "0.6.0",
		"typescript": "7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
		"vite-plus": "0.2.8",
		"vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
	},
	"engines": {
		"node": "26.7.0",
		"pnpm": "11.21.0"
	},
	"packageManager": "pnpm@11.21.0"

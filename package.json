{
  "name": "agents.yaml",
  "version": "0.1.0",
  "description": "A CLI for discovering and curating agent-readable documentation in agents.yaml.",
  "type": "module",
  "bin": {
    "agents": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && tsdown"
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.0.0",
  "dependencies": {
    "@clack/prompts": "1.5.1",
    "yaml": "2.9.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "tsdown": "0.22.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}
